# Server
PORT=3000
# Separe por vírgulas se precisar liberar mais de uma origem.
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_uma_senha_segura
DB_NAME=petcare

# Use a long, unique, random value in each environment.
JWT_SECRET=gere_uma_chave_longa_e_aleatoria

# SMTP para confirmação de e-mail
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_ou_app_password_smtp
MAIL_FROM="PetCare Connect <nao-responda@seu-dominio.com>"
APP_URL=http://localhost:5173
